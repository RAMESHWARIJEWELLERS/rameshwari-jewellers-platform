<?xml version="1.0"?>
<phpunit
	bootstrap="../tests/bootstrap.php"
	backupGlobals="false"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	failOnRisky="true"
	>
	<testsuites>
		<!-- Add unit, rest, security, migration and regression suites as they gain tests. -->
		<testsuite name="integration">
			<directory suffix="Test.php">../tests/integration</directory>
		</testsuite>
	</testsuites>
</phpunit>
