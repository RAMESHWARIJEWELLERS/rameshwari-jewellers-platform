<?xml version="1.0"?>
<phpunit
	bootstrap="../tests/bootstrap.php"
	backupGlobals="false"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	failOnRisky="true"
	>
	<testsuites>
		<!-- Unit tests run inside the WordPress test library because the classes call escaping and JSON helpers. -->
		<testsuite name="unit">
			<directory suffix="Test.php">../tests/unit</directory>
		</testsuite>
		<testsuite name="integration">
			<directory suffix="Test.php">../tests/integration</directory>
		</testsuite>
	</testsuites>
</phpunit>
